# Use Stripe test-mode keys for local development. Never commit your real .env file.
DEBUG=true
DJANGO_SECRET_KEY=replace_with_a_long_random_secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=

# Login rate limiting: 3 failed attempts, followed by a 15-minute cooloff.
AXES_FAILURE_LIMIT=3
AXES_COOLOFF_TIME=0.25

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Platform fee as basis points: 500 means 5%. Default in code is 0.
STRIPE_PLATFORM_FEE_BPS=0

# If true, Stripe returns the application fee proportionally during refunds.
STRIPE_REFUND_APPLICATION_FEE=false

STRIPE_CONNECT_RETURN_URL=http://127.0.0.1:8000/organizers/payments/return/
STRIPE_CONNECT_REFRESH_URL=http://127.0.0.1:8000/organizers/payments/onboarding/

# Local development prints email messages in the runserver terminal.
# For production, set EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend
# and provide the SMTP values through your hosting provider's secret settings.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Events <noreply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Where uploaded images go on a server: any S3-compatible bucket. Leave blank locally.
# Set MEDIA_PUBLIC_DOMAIN only if the bucket is served publicly from that address.
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_PUBLIC_DOMAIN=

# Production-only HTTPS settings. Configure only after HTTPS is active at your host.
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
